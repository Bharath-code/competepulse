# CompetePulse — environment template (E0-2)
# Copy to .env and fill in. NEVER commit real secrets; .env is gitignored.
#
# Local development works WITHOUT any of these set: the crawl pipeline falls
# back to deterministic mock fixtures when FIRECRAWL_API_KEY is absent.

# --- Firecrawl (primary scrape/extract) ---
# https://www.firecrawl.dev/  — when set, /crawl uses the live Firecrawl API.
FIRECRAWL_API_KEY=

# --- Cloudflare (crawl ops / snapshots / metadata) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_BUCKET=competepulse-snapshots
D1_DATABASE_ID=

# --- Slack (primary user surface, via Vercel Eve) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# --- LLM routing (Vercel AI Gateway) ---
AI_GATEWAY_API_KEY=

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
