# CompetePulse — environment template (E0-2)
# Copy to `.env` at the repo root and fill in values as needed.
# NEVER commit real secrets — `.env`, `.env.*`, and `.dev.vars` are gitignored.
#
# Local development works WITHOUT any of these set: the crawl pipeline falls
# back to deterministic mock fixtures when FIRECRAWL_API_KEY is absent.
#
# For Wrangler (`pnpm dev`), also see packages/worker/.dev.vars.example —
# Wrangler reads secrets from packages/worker/.dev.vars, not from root `.env`.

# --- Firecrawl (primary scrape/extract) ---
# https://www.firecrawl.dev/  — when set, /crawl uses the live Firecrawl API.
FIRECRAWL_API_KEY=

# --- Cloudflare (crawl ops / snapshots / metadata) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_BUCKET=competepulse-snapshots
D1_DATABASE_ID=

# --- Slack (primary user surface, via Vercel Eve) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# --- LLM routing (Vercel AI Gateway) ---
AI_GATEWAY_API_KEY=

# --- Dodo Payments (billing, E4-1) ---
# https://docs.dodopayments.com/ — Merchant of Record for India + international.
# Local/dev works WITHOUT these: checkout returns a mock URL that activates the plan.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode (default) or live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Subscription product ids from the Dodo dashboard (Starter $149 / Pro $399)
DODO_PRODUCT_STARTER=
DODO_PRODUCT_PRO=
# Optional override; defaults to <origin>/dashboard?billing=success
DODO_PAYMENTS_RETURN_URL=
