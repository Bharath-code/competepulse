{
  "name": "competepulse",
  "version": "0.0.0",
  "private": true,
  "description": "CompetePulse — Slack-native competitive change agent (monorepo)",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "dev": "pnpm --filter @competepulse/worker dev",
    "dev:landing": "pnpm --filter @competepulse/landing dev",
    "eval": "pnpm --filter @competepulse/core eval",
    "secrets:check": "node scripts/secrets-check.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
