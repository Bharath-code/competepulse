# Cloudflare static-asset headers (also honoured by Netlify/Pages).
# Kept alongside the site so the deploy target cannot drift from the code.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; script-src 'self' https://assets.calendly.com; style-src 'self' 'unsafe-inline' https://assets.calendly.com; img-src 'self' data: https://*.calendly.com; font-src 'self'; connect-src 'self' https://calendly.com https://*.calendly.com; frame-src https://calendly.com; upgrade-insecure-requests

# Fingerprinted bundles: safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted faces are versioned by filename and never mutate in place.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

/og.png
  Cache-Control: public, max-age=604800
