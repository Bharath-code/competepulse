# CompetePulse landing page (P0-3) — copy to `packages/landing/.env`.
#
# Everything here is PUBLIC: Astro inlines these values into the static HTML at
# build time. Never put a secret in this file.
#
# The page builds and runs with none of these set — the call-to-action falls back
# to a mailto: link so it is never dead.

# Canonical origin. Drives <link rel="canonical">, og:url, sitemap and robots.
PUBLIC_SITE_URL=https://competepulse.com

# Calendly event link for the 15-min discovery call. Must be a calendly.com URL;
# the build fails loudly on anything else rather than shipping a broken button.
# Example: https://calendly.com/<user>/15min
PUBLIC_CALENDLY_URL=

# Reply-to address for the email fallback and the footer link.
PUBLIC_CONTACT_EMAIL=hello@competepulse.com

# Worker origin. Set it to link the dashboard from the footer; leave blank to
# keep the page purely about booking a call.
PUBLIC_APP_URL=
