---
import { faq } from "../copy";
---

<section class="section section--soft" id="faq" aria-labelledby="faq-heading">
  <div class="container faq">
    <h2 class="h-display" id="faq-heading">Questions teams ask first.</h2>
    <div class="faq__list">
      {
        faq.map((item, i) => (
          <details open={i === 0}>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    gap: var(--s-5);
  }

  .faq__list {
    border-block-start: 1px solid var(--ink);
  }

  details {
    border-block-end: 1px solid var(--hairline);
  }

  summary {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block: var(--s-4);
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 540;
    letter-spacing: -0.015em;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: "+";
    flex: none;
    font-family: var(--text);
    font-weight: 460;
    color: var(--ink-mute);
    transition: transform 180ms var(--ease-out);
  }

  details[open] summary::after {
    transform: rotate(45deg);
  }

  details p {
    max-width: 60ch;
    padding-block-end: var(--s-4);
    color: var(--ink-mute);
  }

  @media (width >= 56rem) {
    .faq {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
      align-items: start;
    }
  }
</style>
