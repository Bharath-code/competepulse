---
import BookingCta from "./BookingCta.astro";
import Wordmark from "./Wordmark.astro";
---

<header class="header">
  <div class="container header__inner">
    <Wordmark href="/" />
    <!-- Wrapper lives in this component so the scoped media query can hide it. -->
    <span class="header__cta">
      <BookingCta label="Book a call" placement="header" size="sm" />
    </span>
  </div>
</header>

<style>
  .header {
    position: sticky;
    inset-block-start: 0;
    z-index: 20;
    border-block-end: 1px solid transparent;
    background: color-mix(in oklab, var(--bg) 72%, transparent);
    backdrop-filter: blur(12px) saturate(140%);
    /* Reveal the hairline only once the page is scrolled. */
    animation: header-border linear both;
    animation-timeline: scroll(root block);
    animation-range: 0 6rem;
  }

  @keyframes header-border {
    to {
      border-block-end-color: var(--border);
    }
  }

  @supports not (animation-timeline: scroll()) {
    .header {
      border-block-end-color: var(--border);
    }
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 4rem;
  }

  /* Booking stays one tap away while scrolling, down to the narrowest phones. */
  .header__cta {
    display: inline-flex;
  }

  @media (width <= 20rem) {
    .header__cta {
      display: none;
    }
  }
</style>
