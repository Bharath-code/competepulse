---
import { brand } from "../copy";
import BookingCta from "./BookingCta.astro";
import Wordmark from "./Wordmark.astro";
---

<header class="masthead">
  <div class="container masthead__inner">
    <Wordmark size="running" href="/" />
    <p class="masthead__meta">{brand.runningHead}</p>
    <BookingCta label="Book a call" placement="running-head" size="sm" />
  </div>
</header>

<style>
  .masthead {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-sticky);
    border-block-end: 1px solid transparent;
    background: var(--ground);
    animation: masthead-state linear both;
    animation-timeline: scroll(root block);
    animation-range: 0 6rem;
  }

  @keyframes masthead-state {
    to {
      border-block-end-color: var(--rule);
      box-shadow: 0 8px 24px oklch(0.22 0.025 250 / 0.06);
    }
  }

  @supports not (animation-timeline: scroll()) {
    .masthead {
      border-block-end-color: var(--rule);
    }
  }

  .masthead__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 3.15rem;
  }

  .masthead__meta {
    flex: 1;
    padding-inline: var(--space-md);
    border-inline-start: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--t-kicker);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  @media (width <= 52rem) {
    .masthead__meta {
      display: none;
    }
  }

  @media (width <= 20rem) {
    .masthead :global(.btn) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .masthead {
      animation: none;
      border-block-end-color: var(--rule);
    }
  }
</style>
