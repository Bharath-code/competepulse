---
import { cta, nav } from "../copy";
import BookingCta from "./BookingCta.astro";
import Wordmark from "./Wordmark.astro";
---

<header class="nav on-dark">
  <div class="container nav__inner">
    <Wordmark size="running" href="/" />
    <nav class="nav__links" aria-label="Sections">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <BookingCta placement="nav" label={cta.short} variant="pill" size="sm" />
  </div>
</header>

<style>
  .nav {
    position: sticky;
    inset-block-start: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--indigo) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-block-end: 1px solid var(--hairline-dark);
    color: var(--on-dark);
    --wm-ink: var(--on-dark);
    --wm-dot: var(--violet);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    min-height: 3.75rem;
  }

  .nav__links {
    display: flex;
    gap: var(--s-4);
    margin-inline-start: auto;
    font-size: 0.9375rem;
  }

  .nav__links a {
    color: var(--on-dark-mute);
    text-decoration: none;
    transition: color 180ms;
  }

  .nav__links a:hover {
    color: var(--on-dark);
  }

  @media (width < 48rem) {
    .nav__links {
      display: none;
    }

    .nav__inner > :global(.btn) {
      margin-inline-start: auto;
    }
  }
</style>
