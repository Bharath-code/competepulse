---
import { howItWorks } from "../copy";
---

<section class="section" aria-labelledby="how-heading">
  <div class="container">
    <p class="kicker">{howItWorks.kicker}</p>
    <h2 class="section-title" id="how-heading">{howItWorks.title}</h2>

    <ol class="steps">
      {
        howItWorks.steps.map((step) => (
          <li class="step">
            <p class="step__number" aria-hidden="true">
              {step.number}
            </p>
            <div class="step__body">
              <h3 class="step__title">{step.title}</h3>
              <p class="step__text">{step.body}</p>
              {step.command && <p class="step__command">{step.command}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* A printed procedure: numerals in the margin, hairlines between steps. */
  .steps {
    margin-block-start: var(--space-xl);
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--ink);
  }

  .step {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: var(--space-sm);
    padding-block: var(--space-md);
    border-block-end: 1px solid var(--rule);
  }

  @media (width >= 56rem) {
    .step {
      grid-template-columns: 5rem minmax(0, 22ch) minmax(0, 1fr);
      gap: var(--space-lg);
      align-items: start;
      padding-block: var(--space-lg);
    }

    .step__body {
      display: contents;
    }
  }

  .step__number {
    font-family: var(--font-display);
    font-size: 2.4rem;
    line-height: 0.9;
    color: var(--signal);
  }

  .step__title {
    font-size: var(--t-h3);
  }

  .step__text {
    max-width: 58ch;
    margin-block-start: 0.4rem;
    color: var(--ink-2);
  }

  @media (width >= 56rem) {
    .step__text {
      margin-block-start: 0;
    }
  }

  .step__command {
    margin-block-start: var(--space-sm);
    padding: 0.5rem 0.7rem;
    border-inline-start: 2px solid var(--signal);
    background: var(--paper-tint);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    overflow-wrap: anywhere;
  }

  @media (width >= 56rem) {
    .step__command {
      grid-column: 3;
      justify-self: start;
    }
  }
</style>
