---
import { story } from "../copy";

const rows = [
  { deal: "Northwind", amount: "$18,000", stage: "Proposal", rival: "Rival", hit: true },
  { deal: "Bluefin", amount: "$9,000", stage: "Demo", rival: "Other Co", hit: false },
  { deal: "Kestrel", amount: "$26,000", stage: "Negotiation", rival: "Rival", hit: true },
  { deal: "Orchid", amount: "$6,000", stage: "Discovery", rival: "", hit: false },
  { deal: "Halyard", amount: "$14,000", stage: "Proposal", rival: "Other Co", hit: false },
];
const score = [
  { label: "Deals touched", n: 6 },
  { label: "Won", n: 4 },
  { label: "Lost", n: 1 },
  { label: "Still open", n: 1 },
];
---

<section class="section story" aria-labelledby="story-heading" data-story>
  <div class="container">
    <h2 class="section-title story__title" id="story-heading">{story.title}</h2>
    <p class="story__intro">{story.intro}</p>

    <div class="story__body">
      <ol class="story__beats">
        {
          story.beats.map((beat, i) => (
            <li class="beat" data-beat={i}>
              <div class="beat__text">
                <p class="beat__count" aria-hidden="true">
                  {i + 1}/{story.beats.length}
                </p>
                <h3 class="beat__title">{beat.title}</h3>
                <p class="beat__body">{beat.body}</p>
              </div>

              <div class="beat__figure" data-figure={beat.id}>
                {beat.id === "change" && (
                  <div class="shot shot--browser">
                    <div class="shot__chrome">
                      <span class="shot__lights" aria-hidden="true">
                        <i />
                        <i />
                        <i />
                      </span>
                      <span class="shot__url">rival.ai/pricing</span>
                    </div>
                    <div class="price">
                      <p class="price__plan">Pro</p>
                      <p class="price__amount">
                        <span class="price__old" data-old>
                          $49
                          <i class="price__strike" data-strike />
                        </span>
                        <span class="price__window">
                          <span class="price__new" data-new>
                            $79
                          </span>
                        </span>
                      </p>
                      <p class="price__unit">per seat / month, billed annually</p>
                    </div>
                    <div class="diff" role="list" aria-label="What changed">
                      <p class="diff__line diff__line--del" role="listitem" data-diff>
                        − Pro · $49 per seat
                      </p>
                      <p class="diff__line diff__line--add" role="listitem" data-diff>
                        + Pro · $79 per seat
                      </p>
                      <p class="diff__line diff__line--add" role="listitem" data-diff>
                        + SSO moved to Enterprise
                      </p>
                    </div>
                    <p class="shot__meta">Snapshot 3 Oct, 08:12 UTC · judged material</p>
                  </div>
                )}

                {beat.id === "deals" && (
                  <div class="shot shot--table">
                    <p class="shot__head">
                      Open deals <span>from HubSpot, read-only</span>
                    </p>
                    <table class="deals">
                      <thead>
                        <tr>
                          <th scope="col">Deal</th>
                          <th scope="col">Amount</th>
                          <th scope="col">Stage</th>
                          <th scope="col">Competitor</th>
                        </tr>
                      </thead>
                      <tbody>
                        {rows.map((r) => (
                          <tr
                            class={r.hit ? "is-hit" : undefined}
                            data-row={r.hit ? "hit" : "miss"}
                          >
                            <td>{r.deal}</td>
                            <td class="num">{r.amount}</td>
                            <td>{r.stage}</td>
                            <td>
                              {r.rival ? (
                                <span class="chip">{r.rival}</span>
                              ) : (
                                <span class="muted">none</span>
                              )}
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                    <p class="shot__meta">
                      2 of 5 open deals name Rival. Only their owners hear about it.
                    </p>
                  </div>
                )}

                {beat.id === "dm" && (
                  <div class="shot shot--slack">
                    <p class="dm__head">
                      <span class="dm__avatar" aria-hidden="true">
                        CP
                      </span>
                      <b>CompetePulse</b>
                      <span class="dm__app">APP</span>
                      <span class="dm__time">9:41 AM</span>
                    </p>
                    <div class="dm__msg">
                      <p data-dm>
                        <span class="dm__at">@sam</span> Rival raised Pro from $49 to $79 this
                        morning.
                      </p>
                      <p data-dm>
                        Your <b>Northwind</b> deal ($18k, Proposal) is up against them.
                      </p>
                      <div class="dm__evidence" data-dm>
                        <span class="dm__thumb" aria-hidden="true">
                          <s>$49</s> $79
                        </span>
                        <span>rival.ai/pricing · before / after</span>
                      </div>
                      <blockquote class="dm__line" data-dm>
                        “Same features, and our price didn’t move. We can lock it for 12 months.”
                      </blockquote>
                      <p class="dm__buttons" data-dm>
                        <span class="dm__btn dm__btn--primary">Use this line</span>
                        <span class="dm__btn">Edit</span>
                        <span class="dm__btn">Not relevant</span>
                      </p>
                      <p class="dm__approved" data-approved>
                        Line approved by Priya, PMM
                      </p>
                    </div>
                  </div>
                )}

                {beat.id === "result" && (
                  <div class="shot shot--score">
                    <p class="shot__head">
                      Against Rival <span>this quarter</span>
                    </p>
                    <dl class="score">
                      {score.map((s) => (
                        <div class="score__cell">
                          <dt>{s.label}</dt>
                          <dd data-count={s.n}>{s.n}</dd>
                        </div>
                      ))}
                    </dl>
                    <div class="score__bar" aria-hidden="true">
                      <i class="won" style="--w: 4" data-seg />
                      <i class="lost" style="--w: 1" data-seg />
                      <i class="open" style="--w: 1" data-seg />
                    </div>
                    <p class="shot__meta">
                      Win rates appear after 20 closed deals. Until then, counts only.
                    </p>
                  </div>
                )}
              </div>
            </li>
          ))
        }
      </ol>
      <div class="story__stage" data-stage>
        <div class="story__rail" aria-hidden="true">
          {story.beats.map((_, i) => <i data-tick={i} />)}
        </div>
      </div>
    </div>
    <p class="story__caption">{story.caption}</p>
  </div>
</section>

<style>
  .story__intro {
    margin-block-start: var(--space-sm);
    max-width: 52ch;
    font-size: var(--t-lead);
    color: var(--ink-2);
  }

  .story__body {
    margin-block-start: var(--space-xl);
  }

  .story__beats {
    display: grid;
    gap: var(--space-2xl);
    padding: 0;
    list-style: none;
  }

  .beat {
    display: grid;
    gap: var(--space-md);
    align-items: center;
  }

  .beat__text {
    display: grid;
    gap: var(--space-xs);
    max-width: 40ch;
  }

  .beat__count {
    font-family: var(--font-mono);
    font-size: var(--t-small);
    color: var(--signal);
  }

  .beat__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.45rem, 1.1rem + 1.4vw, 2.2rem);
    letter-spacing: -0.03em;
    line-height: 1.08;
  }

  .beat__body {
    color: var(--ink-2);
  }

  .story__stage {
    display: none;
  }

  .story__caption {
    margin-block-start: var(--space-lg);
    font-size: var(--t-small);
    color: var(--ink-3);
  }

  @media (width >= 56rem) {
    .beat {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
      column-gap: var(--space-xl);
    }
  }

  /* Enhanced: figures move into one sticky stage; text beats scroll past it. */
  :global(.story.is-staged) .story__body {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    column-gap: var(--space-xl);
  }

  :global(.story.is-staged) .story__beats {
    gap: 0;
  }

  :global(.story.is-staged) .beat {
    display: block;
    min-height: 78vh;
    padding-block: 22vh;
  }

  :global(.story.is-staged) .beat__text {
    opacity: 0.28;
    transition: opacity 400ms var(--ease-out);
  }

  :global(.story.is-staged) .beat.is-active .beat__text {
    opacity: 1;
  }

  :global(.story.is-staged) .story__stage {
    display: grid;
    position: sticky;
    top: 14vh;
    height: 72vh;
    align-items: center;
  }

  :global(.story.is-staged) .story__stage :global(.beat__figure) {
    grid-area: 1 / 1;
  }

  .story__rail {
    position: absolute;
    inset-inline-start: calc(-1 * var(--space-lg));
    inset-block: 18% 18%;
    display: grid;
    gap: 0.5rem;
  }

  .story__rail i {
    width: 2px;
    background: var(--rule);
    transition: background 300ms;
  }

  .story__rail i.is-on {
    background: var(--signal);
  }

  /* --- shots: product pictures built in markup --- */
  .shot {
    display: grid;
    gap: var(--space-sm);
    padding: clamp(1rem, 2.2vw, 1.5rem);
    border: 1px solid var(--rule);
    border-radius: 0.6rem;
    background: oklch(0.995 0.004 230);
    box-shadow: 0 24px 50px -28px oklch(0.22 0.025 250 / 0.35);
    font-size: 0.95rem;
  }

  .shot__head {
    font-weight: 600;
  }

  .shot__head span,
  .shot__meta,
  .muted {
    color: var(--ink-3);
    font-weight: 400;
  }

  .shot__meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .shot--browser {
    padding: 0 0 clamp(1rem, 2.2vw, 1.5rem);
    overflow: hidden;
  }

  .shot--browser > :not(.shot__chrome) {
    margin-inline: clamp(1rem, 2.2vw, 1.5rem);
  }

  .shot__chrome {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.6rem 0.9rem;
    border-block-end: 1px solid var(--rule);
    background: var(--ground-tint);
  }

  .shot__lights {
    display: flex;
    gap: 0.3rem;
  }

  .shot__lights i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--rule-strong);
  }

  .shot__url {
    flex: 1;
    padding: 0.2rem 0.6rem;
    border-radius: 0.3rem;
    background: var(--ground);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-2);
  }

  .price {
    display: grid;
    gap: 0.2rem;
    padding-block: var(--space-sm);
  }

  .price__plan {
    font-weight: 600;
  }

  .price__amount {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.6rem, 2rem + 2.5vw, 3.8rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .price__old {
    position: relative;
    color: var(--ink-3);
  }

  .price__strike {
    position: absolute;
    inset-inline: -0.05em;
    top: 52%;
    height: 0.09em;
    background: var(--signal);
    transform-origin: left;
  }

  .price__window {
    display: inline-block;
    overflow: hidden;
  }

  .price__new {
    display: inline-block;
    color: var(--signal);
  }

  .price__unit {
    color: var(--ink-3);
    font-size: var(--t-small);
  }

  .diff {
    display: grid;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .diff__line {
    padding: 0.3rem 0.55rem;
    border-radius: 0.25rem;
  }

  .diff__line--del {
    background: var(--ground-tint);
    color: var(--ink-3);
    text-decoration: line-through;
  }

  .diff__line--add {
    background: var(--signal-soft);
    color: var(--signal-deep);
  }

  .deals {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .deals th {
    padding: 0.45rem 0.5rem;
    border-block-end: 1px solid var(--rule-strong);
    text-align: start;
    font-weight: 600;
    font-size: 0.78rem;
    color: var(--ink-3);
  }

  .deals td {
    padding: 0.55rem 0.5rem;
    border-block-end: 1px solid var(--rule);
  }

  .deals .num {
    font-variant-numeric: tabular-nums;
  }

  .deals tr.is-hit td {
    background: var(--signal-soft);
  }

  .deals tr.is-hit td:first-child {
    box-shadow: inset 3px 0 0 var(--signal);
    font-weight: 600;
  }

  .chip {
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: var(--ground-tint);
    font-size: 0.8rem;
  }

  .is-hit .chip {
    background: var(--signal);
    color: oklch(0.99 0 0);
  }

  .shot--slack {
    background: var(--console);
    border-color: var(--console-rule);
    color: var(--console-text);
  }

  .dm__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dm__avatar {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.4rem;
    background: var(--signal);
    font-weight: 600;
    font-size: 0.75rem;
    color: oklch(0.99 0 0);
  }

  .dm__app {
    padding: 0 0.3rem;
    border-radius: 0.2rem;
    background: var(--console-2);
    font-size: 0.65rem;
    color: var(--console-muted);
  }

  .dm__time {
    font-size: 0.8rem;
    color: var(--console-muted);
  }

  .dm__msg {
    display: grid;
    gap: 0.55rem;
    padding-inline-start: 2.5rem;
  }

  .dm__at {
    padding: 0 0.2rem;
    border-radius: 0.2rem;
    background: oklch(0.78 0.1 240 / 0.18);
    color: var(--console-link);
  }

  .dm__evidence {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.5rem;
    border: 1px solid var(--console-rule);
    border-radius: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--console-muted);
  }

  .dm__thumb {
    padding: 0.4rem 0.6rem;
    border-radius: 0.25rem;
    background: var(--console-2);
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--console-high);
  }

  .dm__thumb s {
    color: var(--console-muted);
  }

  .dm__line {
    padding-inline-start: 0.75rem;
    border-inline-start: 3px solid var(--console-high);
    font-style: italic;
  }

  .dm__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .dm__btn {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--console-rule);
    border-radius: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .dm__btn--primary {
    border-color: var(--console-quiet);
    background: oklch(0.78 0.1 155 / 0.16);
    color: var(--console-quiet);
  }

  .dm__approved {
    font-size: 0.8rem;
    color: var(--console-quiet);
  }

  .score {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-sm);
  }

  .score__cell {
    display: grid;
    gap: 0.2rem;
  }

  .score dt {
    font-size: 0.78rem;
    color: var(--ink-3);
  }

  .score dd {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 1.6rem + 1.5vw, 2.8rem);
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .score__bar {
    display: flex;
    gap: 3px;
    height: 0.7rem;
  }

  .score__bar i {
    flex: var(--w);
    border-radius: 2px;
    transform-origin: left;
  }

  .score__bar .won {
    background: var(--moss);
  }

  .score__bar .lost {
    background: var(--signal);
  }

  .score__bar .open {
    background: var(--rule-strong);
  }

  @media (width < 30rem) {
    .score {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .deals th:nth-child(3),
    .deals td:nth-child(3) {
      display: none;
    }
  }
</style>
