---
import { cta } from "../copy";
import { buildMailtoFallback } from "../lib/calendly";
import { resolveConfig } from "../lib/config";

interface Props {
  /** Recorded as `utm_content` on the Calendly link, e.g. `hero`. */
  placement: string;
  label?: string;
  variant?: "primary" | "pill" | "light";
  size?: "sm" | "md";
}

const { placement, label = cta.label, variant = "primary", size = "md" } = Astro.props;
const config = resolveConfig(import.meta.env);

/*
 * Every call-to-action points at the in-page booking band so the visitor never
 * leaves the page and the Calendly bundle stays lazy. With no scheduling link
 * configured we degrade to email rather than shipping a dead button.
 */
const href = config.calendlyUrl
  ? "#book"
  : buildMailtoFallback(config.contactEmail, cta.mailSubject);
---

<a
  class:list={["btn", variant !== "primary" && `btn--${variant}`, size === "sm" && "btn--sm"]}
  href={href}
  data-cta-placement={placement}
>
  {label}<span class="btn__arrow" aria-hidden="true">→</span>
</a>
