---
import { buildMailtoFallback } from "../lib/calendly";
import { resolveConfig } from "../lib/config";

interface Props {
  label: string;
  /** Recorded as `utm_content` on the Calendly link, e.g. `hero`. */
  placement: string;
  size?: "sm" | "md" | "lg";
}

const { label, placement, size = "md" } = Astro.props;
const config = resolveConfig(import.meta.env);

/*
 * Every call-to-action points at the in-page booking section so the visitor
 * never leaves the page and the Calendly bundle stays lazy. With no scheduling
 * link configured we degrade to email rather than shipping a dead button.
 */
const href = config.calendlyUrl
  ? "#book"
  : buildMailtoFallback(config.contactEmail, "CompetePulse — 15-min discovery call");
---

<a
  class:list={["btn", "btn--primary", size !== "md" && `btn--${size}`]}
  href={href}
  data-cta-placement={placement}
>
  {label}
  <svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path
      d="M3 8h9M8.5 4l4 4-4 4"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</a>
