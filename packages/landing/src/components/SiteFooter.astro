---
import { brand, footer } from "../copy";
import { buildMailtoFallback } from "../lib/calendly";
import { resolveConfig } from "../lib/config";
import Wordmark from "./Wordmark.astro";

const config = resolveConfig(import.meta.env);
const mailto = buildMailtoFallback(config.contactEmail, "CompetePulse");
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <Wordmark href={null} />
      <p class="footer__tagline">{brand.tagline}</p>
    </div>

    <p class="footer__note">{footer.note}</p>

    <div class="footer__meta">
      <a href={mailto}>{config.contactEmail}</a>
      {config.appUrl && <a href={`${config.appUrl}/dashboard`}>Dashboard</a>}
      <span>{footer.copyright}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-lg) var(--space-xl);
    border-block-start: 1px solid var(--border);
    background: var(--surface-sunken);
  }

  .footer__inner {
    display: grid;
    gap: var(--space-md);
  }

  @media (min-width: 52rem) {
    .footer__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      align-items: start;
      column-gap: var(--space-xl);
    }

    .footer__meta {
      grid-column: 1 / -1;
    }
  }

  .footer__tagline {
    margin-block-start: 0.4rem;
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  .footer__note {
    max-width: var(--measure);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--border);
    font-size: var(--step--1);
    color: var(--text-faint);
  }
</style>
