---
import { brand, footer } from "../copy";
import { buildMailtoFallback } from "../lib/calendly";
import { resolveConfig } from "../lib/config";
import Wordmark from "./Wordmark.astro";

const config = resolveConfig(import.meta.env);
const mailto = buildMailtoFallback(config.contactEmail, "CompetePulse");
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <Wordmark href={null} />
      <p>{brand.tagline}</p>
    </div>
    <div class="footer__notes">
      <p>{footer.note}</p>
      <p>{footer.colophon}</p>
    </div>
    <p class="footer__meta">
      <a href={mailto}>{config.contactEmail}</a>
      {config.appUrl && <a href={`${config.appUrl}/dashboard`}>Dashboard</a>}
      <span>{footer.copyright}</span>
    </p>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--s-6);
    background: var(--canvas);
    color: var(--ink-mute);
    font-size: var(--t-small);
    --wm-ink: var(--ink);
    --wm-dot: #7b5cf0;
  }

  .footer__inner {
    display: grid;
    gap: var(--s-5);
  }

  .footer__brand,
  .footer__notes {
    display: grid;
    gap: var(--s-1);
    max-width: 44ch;
  }

  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    padding-block-start: var(--s-4);
    border-block-start: 1px solid var(--hairline);
  }

  @media (width >= 56rem) {
    .footer__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .footer__meta {
      grid-column: 1 / -1;
    }
  }
</style>
