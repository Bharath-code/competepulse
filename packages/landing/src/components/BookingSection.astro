---
import { concierge, hero } from "../copy";
import { buildCalendlyUrl, buildMailtoFallback } from "../lib/calendly";
import { resolveConfig } from "../lib/config";

const config = resolveConfig(import.meta.env);
const embedUrl = buildCalendlyUrl(config.calendlyUrl, { placement: "booking", embed: true });
const directUrl = buildCalendlyUrl(config.calendlyUrl, { placement: "booking-direct" });
const mailto = buildMailtoFallback(config.contactEmail, "CompetePulse — 15-min discovery call");
---

<section class="booking night" id="book" aria-labelledby="booking-heading">
  <div class="container booking__grid">
    <div class="booking__pitch">
      <p class="kicker booking__kicker">{concierge.kicker}</p>
      <h2 class="booking__title" id="booking-heading">{concierge.title}</h2>
      <p class="booking__body">{concierge.body}</p>

      <p class="booking__asks-label">{concierge.asksLabel}</p>
      <ul class="booking__asks">
        {concierge.asks.map((ask) => <li>{ask}</li>)}
      </ul>
    </div>

    <!-- Styled as a clip-out coupon: the one thing on the page you tear off. -->
    <div class="booking__coupon" data-calendly-url={embedUrl ?? undefined}>
      <p class="booking__coupon-label">
        <span>{concierge.couponLabel}</span>
        <span>{concierge.couponNote}</span>
      </p>

      {embedUrl && <div class="booking__widget" data-calendly-target />}

      <div class="booking__fallback">
        <p class="booking__fallback-copy">
          {
            directUrl
              ? "Pick any 15-minute slot that suits you — the calendar opens in a new tab."
              : "Scheduling link is being set up. Email works right now."
          }
        </p>
        {
          directUrl ? (
            <a class="btn btn--lg booking__button" href={directUrl} target="_blank" rel="noopener">
              {concierge.ctaLabel}
            </a>
          ) : (
            <a class="btn btn--lg booking__button" href={mailto}>
              {concierge.ctaLabel}
            </a>
          )
        }
        <p class="booking__email">
          {concierge.bookingFallbackNote}
          <a href={mailto}>{config.contactEmail}</a>
        </p>
      </div>

      <p class="booking__meta">{hero.ctaNote}</p>
    </div>
  </div>
</section>

{
  /* Astro hoists and bundles this at build time, so it must not be conditional.
    The script no-ops when no `data-calendly-url` panel is present. */
}
<script>
  import "../scripts/calendly-embed";
</script>

<style>
  .booking {
    padding-block: var(--space-2xl);
  }

  .booking__grid {
    display: grid;
    gap: var(--space-xl);
  }

  @media (width >= 62rem) {
    .booking__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 25rem);
      column-gap: var(--space-2xl);
      align-items: start;
    }
  }

  .booking__kicker {
    color: var(--night-low);
  }

  .booking__kicker::after {
    background: var(--night-rule);
  }

  .booking__title {
    margin-block-start: var(--space-sm);
    max-width: 16ch;
    font-size: var(--t-h2);
    color: var(--night-text);
  }

  .booking__body {
    max-width: 46ch;
    margin-block-start: var(--space-md);
    font-size: var(--t-lead);
    line-height: 1.45;
    color: var(--night-muted);
  }

  .booking__asks-label {
    margin-block-start: var(--space-lg);
    padding-block-end: var(--space-2xs);
    border-block-end: 1px solid var(--night-rule);
    font-family: var(--font-mono);
    font-size: var(--t-kicker);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--night-muted);
  }

  .booking__asks {
    margin-block-start: var(--space-sm);
    padding: 0;
    list-style: none;
    font-size: var(--t-small);
  }

  .booking__asks li {
    padding-block: 0.5rem;
    padding-inline-start: 1.6rem;
    border-block-end: 1px solid var(--night-rule);
    position: relative;
  }

  .booking__asks li::before {
    content: "→";
    position: absolute;
    inset-inline-start: 0;
    color: var(--night-high);
  }

  .booking__coupon {
    padding: clamp(1.1rem, 2.5vw, 1.6rem);
    border: 2px dashed var(--paper-deep);
    background: var(--paper);
    color: var(--ink);
  }

  .booking__coupon-label {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    padding-block-end: var(--space-xs);
    border-block-end: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-size: var(--t-kicker);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .booking__coupon-label span:last-child {
    color: var(--ink-3);
    letter-spacing: 0.06em;
  }

  /* --- embed lifecycle -------------------------------------------------
   * idle         -> booking link only
   * loading      -> skeleton, link still available
   * ready        -> Calendly confirmed it painted; the link steps aside
   * unconfirmed  -> widget mounted but unconfirmed; show both, rather than risk
   *                 hiding a calendar that is probably working
   * error        -> bundle never loaded; link only, no empty box
   */
  .booking__widget {
    display: none;
    margin-block-start: var(--space-md);
  }

  [data-calendly-state="loading"] .booking__widget {
    display: block;
    min-height: 11rem;
    background: repeating-linear-gradient(-45deg, var(--paper-tint) 0 8px, var(--paper) 8px 16px)
      var(--paper-tint);
    animation: coupon-wait 1.4s linear infinite;
  }

  @keyframes coupon-wait {
    to {
      background-position: 22.7px 0;
    }
  }

  /* No min-height once mounted: Calendly's iframe sets its own. */
  [data-calendly-state="ready"] .booking__widget,
  [data-calendly-state="unconfirmed"] .booking__widget {
    display: block;
  }

  [data-calendly-state="ready"] .booking__fallback,
  [data-calendly-state="ready"] .booking__meta {
    display: none;
  }

  .booking__fallback {
    margin-block-start: var(--space-md);
  }

  .booking__fallback-copy {
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  .booking__button {
    width: 100%;
    margin-block-start: var(--space-md);
  }

  .booking__email {
    margin-block-start: var(--space-sm);
    font-size: 0.8rem;
    color: var(--ink-3);
  }

  .booking__meta {
    margin-block-start: var(--space-md);
    padding-block-start: var(--space-sm);
    border-block-start: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--ink-3);
  }
</style>
