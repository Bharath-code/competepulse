---
import { close, cta } from "../copy";
import { buildCalendlyUrl, buildMailtoFallback } from "../lib/calendly";
import { resolveConfig } from "../lib/config";

const config = resolveConfig(import.meta.env);
const embedUrl = buildCalendlyUrl(config.calendlyUrl, { placement: "booking", embed: true });
const directUrl = buildCalendlyUrl(config.calendlyUrl, { placement: "booking-direct" });
const mailto = buildMailtoFallback(config.contactEmail, cta.mailSubject);
---

<section class="close on-dark" id="book" aria-labelledby="close-heading">
  <div class="container close__grid">
    <div class="close__pitch">
      <h2 id="close-heading">{close.title}</h2>
      <p>{cta.reassurance}</p>
    </div>

    <div class="close__panel" data-calendly-url={embedUrl ?? undefined}>
      <p class="close__label">
        <b>{close.bookingLabel}</b>
        <span>{close.bookingNote}</span>
      </p>

      {embedUrl && <div class="close__widget" data-calendly-target />}

      <div class="close__fallback">
        <p class="fine">{directUrl ? close.directNote : close.pendingNote}</p>
        {
          directUrl ? (
            <a class="btn close__button" href={directUrl} target="_blank" rel="noopener">
              {cta.label}
            </a>
          ) : (
            <a class="btn close__button" href={mailto}>
              {cta.label}
            </a>
          )
        }
        <p class="fine">
          {close.emailNote}
          <a href={mailto}>{config.contactEmail}</a>
        </p>
      </div>
    </div>
  </div>
</section>

{
  /* Astro hoists and bundles this at build time, so it must not be conditional.
    The script no-ops when no `data-calendly-url` panel is present. */
}
<script>
  import "../scripts/calendly-embed";
</script>

<style>
  /* DESIGN.md closing teal band: the page's resolving chord. */
  .close {
    padding-block: clamp(4rem, 10vw, 8rem);
    background: var(--teal);
    color: var(--on-dark);
  }

  .close__grid {
    display: grid;
    gap: var(--s-5);
    align-items: center;
  }

  .close__pitch {
    display: grid;
    gap: var(--s-3);
  }

  .close__pitch h2 {
    max-width: 18ch;
    font-size: var(--t-display);
  }

  .close__pitch p {
    font-size: var(--t-lead);
    color: #b9d3d1;
  }

  .close__panel {
    padding: var(--s-5);
    border-radius: var(--r-panel);
    background: var(--canvas);
    color: var(--ink);
  }

  .close__label {
    display: grid;
    gap: 0.15rem;
  }

  .close__label b {
    font-family: var(--display);
    font-size: 1.375rem;
    font-weight: 540;
  }

  .close__label span {
    color: var(--ink-mute);
  }

  .close__widget {
    display: none;
    margin-block-start: var(--s-3);
  }

  [data-calendly-state="loading"] .close__widget {
    display: block;
    min-height: 11rem;
    border-radius: var(--r-btn);
    background: var(--canvas-soft);
  }

  [data-calendly-state="ready"] .close__widget,
  [data-calendly-state="unconfirmed"] .close__widget {
    display: block;
    height: 42rem;
  }

  [data-calendly-state="ready"] .close__fallback {
    display: none;
  }

  .close__fallback {
    display: grid;
    gap: var(--s-2);
    margin-block-start: var(--s-4);
  }

  .close__button {
    width: 100%;
    background: var(--teal);
  }

  .close__button:hover {
    background: var(--teal-mid);
  }

  @media (width >= 60rem) {
    .close__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
      gap: var(--s-6);
    }
  }
</style>
