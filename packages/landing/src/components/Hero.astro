---
import { cta, hero } from "../copy";
import BookingCta from "./BookingCta.astro";

const s = hero.scene;
---

<section class="hero on-dark" aria-labelledby="hero-heading">
  <div class="hero__sky" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__pill">{hero.pill}</p>
      <h1 id="hero-heading">{hero.headline}</h1>
      <p class="hero__lead">{hero.lead}</p>
      <div class="hero__act">
        <BookingCta placement="hero" variant="pill" />
        <p class="hero__assure">{cta.reassurance}</p>
      </div>
    </div>

    <figure class="hero__scene" data-scene>
      <div class="scene">
        <svg
          class="scene__wires"
          viewBox="0 0 560 600"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path data-wire d="M120 222 C 120 262, 190 266, 268 266"></path>
        </svg>

        <div class="mock mock--price scene__price">
          <p class="mock__chrome"><span class="mock__dots" aria-hidden="true"></span>{s.url}</p>
          <div class="mock__body">
            <p class="mock__label">{s.plan}</p>
            <p class="price">
              <span class="price__before">{s.before}<i data-strike></i></span>
              <span class="price__after" data-after>{s.after}</span>
            </p>
            <p class="badge" data-badge>Changed 09:12</p>
          </div>
        </div>

        <p class="scene__counter" aria-hidden="true">
          <span>{s.counter.label}</span>
          <b data-counter={s.counter.value}>{s.counter.value}</b>
        </p>

        <div class="mock scene__deals">
          <p class="mock__head">Open deals <span>HubSpot</span></p>
          <ul class="deals">
            {
              s.deals.map((d) => (
                <li
                  class:list={["deals__row", d.rival && "is-hit"]}
                  data-row={d.rival ? "hit" : "miss"}
                >
                  <span>{d.name}</span>
                  <span class="deals__amt">{d.amount}</span>
                  <span class="chip">{d.rival ? "Rival" : "Other"}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="mock mock--dm scene__dm" data-dm>
          <p class="dm__head">
            <span class="dm__avatar" aria-hidden="true">CP</span><b>CompetePulse</b><span
              class="dm__time">09:40</span
            >
          </p>
          <p class="dm__text"><span class="dm__at">{s.dm.to}</span> {s.dm.text}</p>
          <p class="dm__line">{s.dm.line}</p>
          <p class="dm__ok">
            <svg viewBox="0 0 20 20" aria-hidden="true"
              ><circle cx="10" cy="10" r="8.5"></circle><path data-tick d="M6 10.4l2.6 2.6L14 7.6"
              ></path></svg
            >
            {s.dm.approved}
          </p>
        </div>
      </div>
      <figcaption class="hero__caption">{hero.caption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 7vw, 6rem) clamp(4rem, 8vw, 7rem);
    background: var(--indigo);
    color: var(--on-dark);
  }

  /* DESIGN.md "violet-sky atmospheric backdrop", drawn with gradients, no image. */
  .hero__sky {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 70% at 85% 30%, rgba(201, 180, 250, 0.32), transparent 65%),
      radial-gradient(45% 55% at 70% 85%, rgba(122, 170, 230, 0.22), transparent 70%),
      linear-gradient(180deg, var(--indigo) 0%, var(--indigo-deep) 100%);
  }

  .hero__grid {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__copy {
    display: grid;
    justify-items: start;
    gap: var(--s-4);
  }

  .hero__pill {
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--hairline-dark);
    border-radius: 999px;
    font-size: var(--t-small);
    font-weight: 540;
    color: var(--on-dark-mute);
  }

  h1 {
    max-width: 13ch;
    font-size: var(--t-hero);
    line-height: 0.96;
    letter-spacing: -0.03em;
  }

  .hero__lead {
    max-width: 44ch;
    font-size: var(--t-lead);
    line-height: 1.5;
    color: var(--on-dark-mute);
  }

  .hero__act {
    display: grid;
    justify-items: start;
    gap: var(--s-2);
  }

  .hero__assure,
  .hero__caption {
    font-size: var(--t-small);
    color: var(--on-dark-mute);
  }

  .hero__caption {
    margin-block-start: var(--s-3);
    max-width: 48ch;
  }

  .scene {
    position: relative;
    display: grid;
    gap: var(--s-3);
    color: var(--ink);
  }

  .scene__wires,
  .scene__counter {
    display: none;
  }

  @media (width >= 64rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    }

    .scene {
      display: block;
      aspect-ratio: 560 / 600;
    }

    .scene > .mock,
    .scene__counter {
      position: absolute;
    }

    .scene__price {
      inset: 5% auto auto 0;
      width: 43%;
    }

    .scene__deals {
      inset: 25% 0 auto auto;
      width: 52%;
    }

    .scene__dm {
      inset: auto auto 0 3%;
      width: 60%;
    }

    .scene__counter {
      inset: 0 0 auto auto;
      display: flex;
      align-items: baseline;
      gap: var(--s-2);
      padding: 0.45rem 0.8rem;
      border: 1px solid var(--hairline-dark);
      border-radius: 999px;
      color: var(--on-dark-mute);
      font-size: var(--t-small);
    }

    .scene__counter b {
      font-family: var(--display);
      font-size: 1.25rem;
      font-weight: 540;
      color: var(--on-dark);
      font-variant-numeric: tabular-nums;
    }

    .scene__wires {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    .scene__wires path {
      fill: none;
      stroke: var(--violet);
      stroke-width: 1.75;
      stroke-linecap: round;
      vector-effect: non-scaling-stroke;
    }
  }
</style>
