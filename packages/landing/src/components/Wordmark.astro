---
import { brand } from "../copy";
import { MARK_24 } from "../lib/mark.js";

interface Props {
  /** Nameplate scale for the hero brand, running size in chrome. */
  size?: "nameplate" | "running";
  href?: string | null;
}

const { size = "running", href = "/" } = Astro.props;
const Tag = href ? "a" : "span";
const { dot } = MARK_24;
---

<Tag class:list={["wordmark", `wordmark--${size}`]} href={href ?? undefined}>
  <svg class="wordmark__mark" viewBox={MARK_24.viewBox} aria-hidden="true" focusable="false">
    <path class="wordmark__ring" d={MARK_24.ring}></path>
    <circle class="wordmark__ping" cx={dot.cx} cy={dot.cy} r={dot.r}></circle>
    <circle class="wordmark__dot" cx={dot.cx} cy={dot.cy} r={dot.r}></circle>
  </svg>
  <span class="wordmark__text">{brand.name}</span>
</Tag>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.32em;
    color: var(--wm-ink, var(--ink));
    font-family: var(--font-display, var(--display));
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  /* Optically sized to the cap height of the word, nudged down to its baseline. */
  .wordmark__mark {
    width: 1.12em;
    height: 1.12em;
    overflow: visible;
    translate: 0 0.04em;
  }

  .wordmark__ring {
    fill: currentColor;
  }

  .wordmark__dot,
  .wordmark__ping {
    fill: var(--wm-dot, #7b5cf0);
  }

  .wordmark__ping {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  /* One ping on hover: the signal reaching the deal. */
  a.wordmark:hover .wordmark__ping {
    animation: wordmark-ping 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes wordmark-ping {
    from {
      opacity: 0.6;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(3.2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a.wordmark:hover .wordmark__ping {
      animation: none;
    }
  }

  .wordmark--nameplate {
    font-size: clamp(2.1rem, 1.2rem + 3.8vw, 4rem);
    letter-spacing: -0.035em;
  }

  .wordmark--running {
    font-size: 1.2rem;
    letter-spacing: -0.025em;
  }
</style>
