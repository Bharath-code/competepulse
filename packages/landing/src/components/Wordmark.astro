---
import { brand } from "../copy";

interface Props {
  /** Nameplate scale for the hero brand, running size in chrome. */
  size?: "nameplate" | "running";
  href?: string | null;
}

const { size = "running", href = "/" } = Astro.props;
const Tag = href ? "a" : "span";
---

<Tag class:list={["wordmark", `wordmark--${size}`]} href={href ?? undefined}>
  <svg class="wordmark__mark" viewBox="0 0 26 16" aria-hidden="true" focusable="false">
    <path
      d="M0.9 9.4h3.3l2-6 3.3 12.1 2.4-8.4 1.6 2.3h11.6"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="square"
      stroke-linejoin="miter"></path>
  </svg>
  <span class="wordmark__text">{brand.name}</span>
</Tag>

<style>
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark__mark {
    width: 1.05em;
    align-self: center;
    color: var(--signal);
  }

  .wordmark--nameplate {
    font-size: clamp(2.1rem, 1.2rem + 3.8vw, 4rem);
    letter-spacing: -0.035em;
  }

  .wordmark--running {
    font-size: 1.2rem;
    letter-spacing: -0.025em;
  }
</style>
