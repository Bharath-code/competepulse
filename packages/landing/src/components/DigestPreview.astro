---
import { digestPreview, hero } from "../copy";
---

<section class="section proof" aria-labelledby="digest-heading">
  <div class="container proof__inner">
    <p class="label">{digestPreview.kicker}</p>
    <h2 class="section-title" id="digest-heading">{digestPreview.title}</h2>
    <p class="lead">{digestPreview.body}</p>

    <dl class="proof__facts">
      {
        hero.facts.map((fact) => (
          <div class="proof__fact">
            <dt>{fact.label}</dt>
            <dd>{fact.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .proof {
    border-block-start: 1px solid var(--rule);
    background: oklch(0.965 0.01 230);
  }

  .proof__inner {
    max-width: 54rem;
  }

  .proof__facts {
    display: grid;
    gap: 0;
    margin-block-start: var(--space-lg);
    border-block-start: 1px solid var(--ink);
  }

  @media (width >= 48rem) {
    .proof__facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-block-end: 1px solid var(--rule);
    }
  }

  .proof__fact {
    padding-block: var(--space-md);
    border-block-end: 1px solid var(--rule);
  }

  @media (width >= 48rem) {
    .proof__fact {
      padding-inline: var(--space-md);
      border-block-end: none;
      border-inline-start: 1px solid var(--rule);
    }

    .proof__fact:first-child {
      padding-inline-start: 0;
      border-inline-start: none;
    }
  }

  .proof__fact dt {
    font-family: var(--font-mono);
    font-size: var(--t-kicker);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .proof__fact dd {
    margin-block-start: 0.35rem;
    margin-inline-start: 0;
    max-width: 34ch;
    font-size: var(--t-small);
    color: var(--ink-2);
  }
</style>
