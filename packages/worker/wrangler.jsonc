{
  "name": "competepulse-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DODO_PAYMENTS_ENVIRONMENT": "test_mode",
  },
  // D1 binding for production watchlists (schema: migrations/).
  // Local/tests use the in-memory MemoryStore.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "competepulse",
      "database_id": "294bf257-2999-4b74-bbc1-d2fe976605ab",
      "migrations_dir": "migrations",
    },
  ],
  // R2 omitted until the account enables R2 in the Cloudflare dashboard.
  // Worker falls back to in-memory snapshots when SNAPSHOTS is unset.
  // Crawl fan-out + retries (E2-1)
  "queues": {
    "producers": [{ "binding": "CRAWL_QUEUE", "queue": "competepulse-crawl" }],
    "consumers": [
      {
        "queue": "competepulse-crawl",
        "max_batch_size": 10,
        "max_retries": 5,
      },
    ],
  },
  // Weekday digest schedule — Mon–Fri 13:00 UTC (E1-4)
  "triggers": {
    "crons": ["0 13 * * 1-5"],
  },
}
